ENVIRONMENT=dev
RPC_URL=https://api.devnet.solana.com
WS_URL=wss://api.devnet.solana.com
RELAYER_KEYPAIR_PATH=./relayer-keypair.json
LISTEN_ADDR=0.0.0.0:3001
API_KEYS=["dev-test-key"]
RATE_LIMIT_PER_MINUTE=60
# Requests per minute from one client network: an IPv4 address or an IPv6 /64. An IPv6 /48
# also has a limit at 16 times this rate, shared by every network in that /48. It matters
# only once the service has IPv6 ingress.
EXECUTOR_PER_IP_RATE_LIMIT_PER_MIN=30
# Each entry: {"api_key": "...", "name": "...", "quota": 0, "public": false}.
# Set "public": true for every key that ships in a browser or an app. It must have quota 0.
INTEGRATORS=[]
CORS_ORIGINS=[]

# Development without this URL uses an insecure validation pass-through.
# Production requires the URL, its authority signature, and a validator key.
# VALIDATION_SERVICE_URL=http://127.0.0.1:3002
# VALIDATION_SERVICE_URL_SIGNATURE=
# VALIDATION_API_KEY=

# Debug builds use a neutral scoring policy when this variable is absent.
# Every release build requires a valid bundle signed by the scoring authority.
# EXECUTOR_SCORING_CONFIG_BUNDLE=

CHALLENGE_TTL_SECS=180
VALIDATION_WALLET_MAX_ATTEMPTS=5
VALIDATION_WALLET_WINDOW_SECS=3600
# Paired sessions stay off until both this service and the validator enable them.
EXECUTOR_PAIRED_ENABLED=false
EXECUTOR_PAIRED_SESSION_CONCURRENCY=16
# A paired open and finalize must carry a wallet-signed authorization.
# Use "optional" during a client rollout only. Roll out in this order: "optional" here and
# "observe" below, then the clients, then "required", then "enforce" once
# entros_paired_authorization_network_mismatch_total stays near zero.
EXECUTOR_PAIRED_AUTHORIZATION=required
# "enforce" refuses a paired open from another client network than the authorization's.
# "observe" serves it and counts it.
EXECUTOR_PAIRED_AUTHORIZATION_NETWORK=enforce
# Seconds, 300-3600. Clients drop an authorization with under 120 seconds left.
EXECUTOR_PAIRED_AUTHORIZATION_TTL_SECS=900
# 32 random bytes as 64 hex characters, for example from `openssl rand -hex 32`.
# Production with paired sessions on requires it. Unset draws a key at start.
# EXECUTOR_PAIRED_AUTHORIZATION_KEY_HEX=
# "refuse" makes /validate-features refuse updates as well as baseline writes.
# It needs EXECUTOR_PAIRED_ENABLED=true.
EXECUTOR_SINGLE_CAPTURE_UPDATES=allow
# The study routes answer 404 until this is true.
EXECUTOR_STUDY_ROUTES_ENABLED=false
RUST_LOG=executor_node=info,tower_http=debug
PORT=3001
